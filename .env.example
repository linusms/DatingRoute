# Naver Cloud Platform (Maps, Directions, Geocoding)
NEXT_PUBLIC_NCP_CLIENT_ID='your_ncp_client_id'
NCP_CLIENT_SECRET='your_ncp_client_secret'

# Naver Developers (Search: local, blog)
NAVER_CLIENT_ID='your_naver_client_id'
NAVER_CLIENT_SECRET='your_naver_client_secret'

# YouTube Data API v3
YOUTUBE_API_KEY='your_youtube_api_key'

# Gemini API
GEMINI_API_KEY='your_gemini_api_key'

# Kakao JS Key (Client-side)
NEXT_PUBLIC_KAKAO_JS_KEY='your_kakao_js_key'

# TourAPI (한국관광공사 국문 관광정보 서비스)
# Get your key at https://www.data.go.kr
TOUR_API_KEY='your_tour_api_key'
