# Supabase
NEXT_PUBLIC_SUPABASE_URL='https://your-project.supabase.co'
# Browser key: Realtime Broadcast only (all tables are locked by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY='your_publishable_key'
# Server-only key that bypasses RLS (sb_secret_... or service_role). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY='your_secret_key'

# Naver Cloud Platform (Maps, Directions, Geocoding)
NEXT_PUBLIC_NCP_CLIENT_ID='your_ncp_client_id'
NCP_CLIENT_SECRET='your_ncp_client_secret'

# Naver Developers (Search: local, blog)
NAVER_CLIENT_ID='your_naver_client_id'
NAVER_CLIENT_SECRET='your_naver_client_secret'

# YouTube Data API v3
YOUTUBE_API_KEY='your_youtube_api_key'

# Gemini API
GEMINI_API_KEY='your_gemini_api_key'
# Optional: model names (defaults: gemini-3.5-flash, falling back to gemini-2.5-flash)
# GEMINI_MODEL='gemini-3.5-flash'
# GEMINI_FALLBACK_MODEL='gemini-2.5-flash'

# Kakao JS Key (Client-side)
NEXT_PUBLIC_KAKAO_JS_KEY='your_kakao_js_key'

# TourAPI (한국관광공사 국문 관광정보 서비스)
# Get your key at https://www.data.go.kr
TOUR_API_KEY='your_tour_api_key'

# Public site URL used for share-link previews (Open Graph). Defaults to https://datingroute.vercel.app
# NEXT_PUBLIC_SITE_URL='https://datingroute.vercel.app'
